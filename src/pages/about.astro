---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import { person, hero, stats, experience, testimonials, featuredIn } from '../data/content';

// Build-time check: show /profile.* only if a file exists in public/.
const photos = Object.keys(import.meta.glob('/public/profile.*', { eager: false }));
const photoPath = photos[0]?.replace('/public', '');
const current = experience[0];
const stripStats = stats.slice(0, 4);
---

<Layout
  title={`About | ${person.name}`}
  description={`${person.name} is ${person.title} at ${person.company}, leading a ${person.teamSize}-person team and shipping data systems at scale for ${person.yearsExperience} years.`}
  canonicalPath="/about/"
>
  <Nav />
  <main class="container page-narrow">
    <div class="about-head">
      {photoPath
        ? <img class="about-photo" src={photoPath} alt={person.name} width="96" height="96" />
        : <span class="about-initials" aria-hidden="true">KA</span>}
      <div>
        <p class="section-tag">About</p>
        <h1 class="section-title">{person.name}</h1>
      </div>
    </div>
    <p class="about-lead">{hero.headline}</p>
    <p>{hero.subhead}</p>
    <p>{current.highlights[0]} {current.highlights[1]}</p>
    <p>Based in {person.location}.</p>

    <ul class="about-stats" aria-label="Highlights">
      {stripStats.map((s) => <li><strong>{s.value}</strong><span>{s.label}</span></li>)}
    </ul>

    {testimonials.length > 0 && (
      <section class="about-section" aria-labelledby="testimonials-title">
        <h2 id="testimonials-title">What people say</h2>
        {testimonials.map((t) => (
          <figure class="about-quote">
            <blockquote>{t.quote}</blockquote>
            <figcaption>{t.name}, {t.role}</figcaption>
          </figure>
        ))}
      </section>
    )}

    {featuredIn.length > 0 && (
      <section class="about-section" aria-labelledby="featured-title">
        <h2 id="featured-title">Featured in</h2>
        <ul class="about-featured">
          {featuredIn.map((f) => <li><a class="text-link" href={f.href} target="_blank" rel="noopener">{f.label} ↗</a></li>)}
        </ul>
      </section>
    )}

    <p class="about-links">
      <a class="text-link" href="/writing/">Read the writing →</a>
      <a class="text-link" href="/contact/">Contact →</a>
      <a class="text-link" href={person.resume}>Resume (PDF)</a>
    </p>
  </main>
  <Footer />
</Layout>
