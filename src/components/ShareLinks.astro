---
interface Props {
  title: string;
  url: string;
}
const { title, url } = Astro.props;
const enc = encodeURIComponent;
const linkedin = `https://www.linkedin.com/sharing/share-offsite/?url=${enc(url)}`;
const x = `https://twitter.com/intent/tweet?text=${enc(title)}&url=${enc(url)}`;
---

<!-- div, not nav: global.css gives bare `nav` sticky positioning -->
<div class="share-links" role="group" aria-label="Share this post">
  <span class="share-label">Share:</span>
  <a class="text-link" href={linkedin} target="_blank" rel="noopener noreferrer">LinkedIn ↗</a>
  <a class="text-link" href={x} target="_blank" rel="noopener noreferrer">X ↗</a>
  <button type="button" class="copy-link-btn" data-copy-link={url}>Copy link</button>
  <span class="copy-status" role="status" aria-live="polite"></span>
</div>
