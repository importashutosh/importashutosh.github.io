---
import siteConfig from '../../site.config';
import { person } from '../data/content';

const endpoint = siteConfig.contact.formEndpoint;
---

<div class="contact-form">
  <p class="contact-links">
    <a class="btn btn-primary" href={person.calendly} target="_blank" rel="noopener">Book a call ↗</a>
    <a class="btn btn-ghost" href={person.linkedin} target="_blank" rel="noopener">Message on LinkedIn ↗</a>
  </p>
  {endpoint && (
    <form method="post" action={endpoint} class="form">
      <div class="form-field">
        <label for="cf-name">Name</label>
        <input id="cf-name" name="name" type="text" autocomplete="name" required />
      </div>
      <div class="form-field">
        <label for="cf-email">Email</label>
        <input id="cf-email" name="email" type="email" autocomplete="email" required />
      </div>
      <div class="form-field">
        <label for="cf-message">Message</label>
        <textarea id="cf-message" name="message" rows="6" required></textarea>
      </div>
      <input type="text" name="_gotcha" tabindex="-1" autocomplete="off" aria-hidden="true" style="display:none" />
      <button type="submit" class="btn btn-primary">Send message</button>
    </form>
  )}
</div>
